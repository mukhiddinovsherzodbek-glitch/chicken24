# Bu faylni .env nomi bilan nusxalang va qiymatlarni to'ldiring.
# .env hech qachon git'ga qo'shilmaydi (.gitignore'da). Bu faylda faqat namunalar - haqiqiy qiymat yozmang.

# @BotFather bergan token
BOT_TOKEN=your_token_here

# Buyurtma cheklari keladigan Telegram foydalanuvchi ID (raqam).
# Admin avval botga /start yozgan bo'lishi SHART, aks holda bot unga yoza olmaydi.
ADMIN_ID=123456789

# Mini App manzili (faqat https://)
WEBAPP_URL=https://example.pages.dev

# --- Ixtiyoriy (nisbiy yo'llar bot/ papkasiga nisbatan) ---
# MENU_PATH=../miniapp/menu.json
# DB_PATH=chicken24.db

# --- Server (Render) rejimi. Lokal kompyuterda BU QATORLARNI YOQMANG ---
# Berilsa - PostgreSQL (Neon), berilmasa - lokal SQLite (DB_PATH).
# DATABASE_URL=postgresql://user:password@host/dbname?sslmode=require
# Ikkalasi berilsa - webhook rejimi, berilmasa - polling.
# WEBHOOK_URL=https://your-service.onrender.com
# WEBHOOK_SECRET=random_string_16_to_256_chars_A-Z_a-z_0-9_-
# Webhook HTTP porti (Render o'zi beradi, qo'lda yozish shart emas)
# PORT=8080
# Self-ping manzili (Render RENDER_EXTERNAL_URL ni o'zi beradi; boshqa serverda qo'lda). Lokalda YOQMANG
# PUBLIC_URL=https://your-service.onrender.com

# --- Buyurtma cheklari guruhi (ixtiyoriy) ---
# Bo'sh bo'lsa cheklar ADMIN_ID ga. Guruh ID si manfiy son: guruhda /guruh_id yozib oling.
ORDERS_CHAT_ID=
# 1 bo'lsa chek guruhdan tashqari admin'ning shaxsiy chatiga ham keladi (standart: yo'q)
ORDERS_ALSO_ADMIN=
